# Copy this file to .env before running docker compose.
# The compose profile overrides backend addresses to use service names, not localhost.

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_BATCH_TOKENS=8192
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BASE_DELAY=1
EMBEDDING_MAX_DELAY=30

VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_URL=http://qdrant:6333
QDRANT_URL=http://qdrant:6333
VECTOR_STORE_COLLECTION=enterprise_kb
VECTOR_STORE_DISTANCE_METRIC=cosine
VECTOR_STORE_BATCH_SIZE=64
VECTOR_STORE_TIMEOUT=30
VECTOR_STORE_MAX_RETRIES=3
VECTOR_STORE_BASE_DELAY=0.5
VECTOR_STORE_MAX_DELAY=8
VECTOR_STORE_RECREATE=false

REDIS_URL=redis://redis:6379/0
CACHE_NAMESPACE=rag-cache
CACHE_ENABLED=true
CACHE_EMBEDDING_ENABLED=true
CACHE_RETRIEVAL_ENABLED=true
CACHE_ANSWER_ENABLED=true
CACHE_EMBEDDING_TTL=604800
CACHE_RETRIEVAL_TTL=900
CACHE_ANSWER_TTL=300
CACHE_TIMEOUT=0.25

ACL_ENABLED=true
ACL_METADATA_KEY=acl
ACL_DEFAULT_DENY=true
ACL_PRINCIPAL_HEADER=X-Principal
ACL_ALLOW_BODY_PRINCIPAL=false
ACL_INGEST_BINDINGS_ENABLED=false
METADATA_DB_URL=mysql://rag_user:rag_password@mysql:3306/rag_metadata
MYSQL_DATABASE=rag_metadata
MYSQL_USER=rag_user
MYSQL_PASSWORD=rag_password
MYSQL_ROOT_PASSWORD=rag_root_password

OBSERVABILITY_ENABLED=true
AUDIT_ENABLED=true
METRICS_ENABLED=true
AUDIT_LOG_PATH=logs/audit.jsonl
AUDIT_LOG_QUERY_TEXT=false
AUDIT_QUERY_TEXT_MAX_LENGTH=128
AUDIT_PRINCIPAL_MODE=hash
# Required when AUDIT_ENABLED=true. Use a long random value; do not commit the real one.
AUDIT_HASH_SALT=
AUDIT_LOG_MAX_BYTES=10485760
AUDIT_LOG_BACKUP_COUNT=5
AUDIT_QUEUE_SIZE=10000
METRICS_NAMESPACE=rag
METRICS_PATH=/metrics
READINESS_TIMEOUT=2.0

RERANK_ENABLED=false
RERANK_PROVIDER=deterministic
HYBRID_ENABLED=false
QUERY_REWRITE_ENABLED=false
PARENT_CHILD_ENABLED=false
CONTEXT_PACKING_ENABLED=false
CONTEXT_DEDUP_ENABLED=false

RUN_COMPOSE_INIT=true
COMPOSE_INIT_KNOWLEDGE_BASE_PATH=/app/eval/fixtures/knowledge_base
