EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_BATCH_TOKENS=8192
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BASE_DELAY=1
EMBEDDING_MAX_DELAY=30

VECTOR_STORE_PROVIDER=memory
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=6333
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=
VECTOR_STORE_COLLECTION=enterprise_kb
VECTOR_STORE_DISTANCE_METRIC=cosine
VECTOR_STORE_BATCH_SIZE=64
VECTOR_STORE_TIMEOUT=30
VECTOR_STORE_MAX_RETRIES=3
