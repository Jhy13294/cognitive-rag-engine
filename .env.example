DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-your-openai-api-key
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_BATCH_TOKENS=8192
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BASE_DELAY=1
EMBEDDING_MAX_DELAY=30

# Document ingestion
PDF_EXTRACT_TABLES=false
PDF_OCR_ENABLED=false
PDF_OCR_MIN_CHARS=1
PDF_OCR_DPI=200

VECTOR_STORE_PROVIDER=memory
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=6333
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=
VECTOR_STORE_COLLECTION=enterprise_kb
VECTOR_STORE_DISTANCE_METRIC=cosine
VECTOR_STORE_BATCH_SIZE=64
VECTOR_STORE_TIMEOUT=30
VECTOR_STORE_MAX_RETRIES=3
VECTOR_STORE_BASE_DELAY=0.5
VECTOR_STORE_MAX_DELAY=8
VECTOR_STORE_RECREATE=false

RERANK_ENABLED=false
RERANK_PROVIDER=deterministic
RERANK_MODEL=deterministic-lexical-reranker
RERANK_FETCH_K=30
RERANK_TOP_N=5
RERANK_BATCH_SIZE=32
RERANK_API_KEY=
RERANK_API_URL=https://api.cohere.com/v2/rerank
RERANK_TIMEOUT=30
RERANK_MAX_RETRIES=3
RERANK_BASE_DELAY=0.5
RERANK_MAX_DELAY=8
COHERE_API_KEY=

HYBRID_ENABLED=false
HYBRID_DENSE_WEIGHT=0.2
HYBRID_SPARSE_WEIGHT=1.0
RRF_K=60
BM25_K1=1.5
BM25_B=0.75

PARENT_CHILD_ENABLED=false
PARENT_CHUNK_SIZE=1600
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=80

CONTEXT_PACKING_ENABLED=false
CONTEXT_DEDUP_ENABLED=false
CONTEXT_NEAR_DUP_ENABLED=false
CONTEXT_NEAR_DUP_THRESHOLD=0.9
CONTEXT_MAX_TOKENS=2048
TOKENIZER_ENCODING=cl100k_base

QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_PROVIDER=deterministic
QUERY_REWRITE_FIXTURE_PATH=eval/fixtures/query_rewrites.jsonl
QUERY_REWRITE_NUM_QUERIES=3
QUERY_REWRITE_TEMPERATURE=0.1
QUERY_REWRITE_CACHE_ENABLED=true
QUERY_REWRITE_WEIGHT_ORIGINAL=1.0
QUERY_REWRITE_WEIGHT_VARIANT=0.7

REDIS_URL=redis://localhost:6379/0
CACHE_NAMESPACE=rag-cache
CACHE_ENABLED=false
CACHE_EMBEDDING_ENABLED=true
CACHE_RETRIEVAL_ENABLED=true
CACHE_ANSWER_ENABLED=true
CACHE_EMBEDDING_TTL=604800
CACHE_RETRIEVAL_TTL=900
CACHE_ANSWER_TTL=300
CACHE_TIMEOUT=0.25

ACL_ENABLED=false
ACL_METADATA_KEY=acl
ACL_DEFAULT_DENY=true
ACL_PRINCIPAL_HEADER=X-Principal
ACL_ALLOW_BODY_PRINCIPAL=false
ACL_INGEST_BINDINGS_ENABLED=false
METADATA_DB_URL=mysql://rag_user:rag_password@localhost:3306/rag_metadata
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=rag_user
MYSQL_PASSWORD=rag_password
MYSQL_DATABASE=rag_metadata

OBSERVABILITY_ENABLED=false
AUDIT_ENABLED=false
METRICS_ENABLED=false
AUDIT_LOG_PATH=logs/audit.jsonl
AUDIT_LOG_QUERY_TEXT=false
AUDIT_QUERY_TEXT_MAX_LENGTH=128
AUDIT_PRINCIPAL_MODE=hash
AUDIT_HASH_SALT=replace-with-a-long-random-secret
AUDIT_LOG_MAX_BYTES=10485760
AUDIT_LOG_BACKUP_COUNT=5
AUDIT_QUEUE_SIZE=10000
METRICS_NAMESPACE=rag
METRICS_PATH=/metrics
READINESS_TIMEOUT=2.0

# Ragas generation-quality evaluation. Offline replay needs no API key.
RAGAS_ENABLED=false
RUN_RAGAS_EVAL=false
RAGAS_DO_NOT_TRACK=true
# Defaults to DEEPSEEK_API_KEY when empty.
RAGAS_JUDGE_API_KEY=
# DeepSeek OpenAI-compatible base URL, not the /chat/completions endpoint.
RAGAS_JUDGE_BASE_URL=https://api.deepseek.com/v1
RAGAS_JUDGE_MODEL=deepseek-v4-pro
RAGAS_JUDGE_TEMPERATURE=0
RAGAS_JUDGE_TIMEOUT=60
RAGAS_JUDGE_MAX_RETRIES=3
# Ragas structured-output judge truncates at the instructor default 1024; 4096+ avoids IncompleteOutputException.
RAGAS_JUDGE_MAX_TOKENS=4096
# Prefer an odd count so median aggregation has one unambiguous center value.
RAGAS_LIVE_REPETITIONS=5
# Pins only live fixture capture generation; the product default remains 0.7.
RAGAS_LIVE_GENERATION_TEMPERATURE=0
# answer-relevance embedding provider: bge (default; local fastembed/ONNX, no API quota) or gemini (remote API).
# Leave MODEL/DIMENSION unset to take the provider default:
#   bge    -> BAAI/bge-small-en-v1.5 / 384   (local, English golden set, no torch)
#   gemini -> gemini-embedding-001 / 3072    (remote, needs API key/base url below)
RAGAS_EMBEDDING_PROVIDER=bge
# Only used by the gemini provider; falls back to GEMINI_API_KEY or GOOGLE_API_KEY. Not required for bge.
RAGAS_EMBEDDING_API_KEY=
RAGAS_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# RAGAS_EMBEDDING_MODEL=
# RAGAS_EMBEDDING_DIMENSION=
# Optional local model cache dir for PROVIDER=bge (defaults to the fastembed cache).
RAGAS_EMBEDDING_CACHE_DIR=
RAGAS_EMBEDDING_BATCH_SIZE=100
RAGAS_EMBEDDING_TIMEOUT=30
RAGAS_EMBEDDING_MAX_RETRIES=3
RAGAS_EMBEDDING_BASE_DELAY=0.5
RAGAS_EMBEDDING_MAX_DELAY=8
RAGAS_FIXTURE_PATH=eval/fixtures/ragas_verdicts.jsonl
RAGAS_REPORT_DIR=eval/reports/ragas
RAGAS_TOP_K=5
RAGAS_FAITHFULNESS_THRESHOLD=0.70
RAGAS_ANSWER_RELEVANCE_THRESHOLD=0.70
RAGAS_CONTEXT_PRECISION_THRESHOLD=0.70
RAGAS_CONTEXT_RECALL_THRESHOLD=0.70
RAGAS_NEGATIVE_ABSTENTION_THRESHOLD=1.0
RAGAS_FAITHFULNESS_MARGIN=0.10
RAGAS_ANSWER_RELEVANCE_MARGIN=0.10
RAGAS_CONTEXT_PRECISION_MARGIN=0.10
RAGAS_CONTEXT_RECALL_MARGIN=0.10
RAGAS_SIGMA_MULTIPLIER=1.0
